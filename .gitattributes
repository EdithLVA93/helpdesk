# Normaliza los finales de línea en el repositorio, sin depender de la
# configuración core.autocrlf de cada máquina.
* text=auto

# Archivos que Windows/Visual Studio esperan con CRLF
*.sln     text eol=crlf
*.slnx    text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Scripts de shell siempre con LF
*.sh      text eol=lf

# Binarios
*.png     binary
*.jpg     binary
*.ico     binary
*.woff    binary
*.woff2   binary

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Los comentarios XML de los controladores se incluyen en el documento OpenAPI. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: no exige comentario XML en cada miembro público. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelpDesk.Application\HelpDesk.Application.csproj" />
    <!-- Solo para registrar la infraestructura en la inyección de dependencias. -->
    <ProjectReference Include="..\HelpDesk.Infrastructure\HelpDesk.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

</Project>
